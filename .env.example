# Copy to .env.local and fill in. Never commit real values.
# Contact form: iCloud SMTP (see README "Environment variables").
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@icloud.com
# Apple app-specific password (appleid.apple.com > Sign-In and Security)
SMTP_PASS=
SMTP_FROM="Fuchs Sales and Consulting <you@icloud.com>"
SMTP_TO=you@icloud.com

# Admin panel (/admin). Without ADMIN_USERS and ADMIN_SESSION_SECRET it is
# switched off (404). Create a user entry with: node scripts/hash-password.mjs
# ADMIN_USERS=[{"email":"you@example.com","name":"Greg","hash":"scrypt:..."}]
# ADMIN_SESSION_SECRET=   (32+ random characters; the script prints one)
# Live site only: saves become commits to GitHub. Unset locally, where saves
# write to content/ and public/ in the working copy.
# GITHUB_TOKEN=           (fine-grained token, this repo, Contents: read & write)
# GITHUB_REPO=MatthewFuchs/dad-portfolio
# GITHUB_BRANCH=main

# Shown in mailto links on the site
NEXT_PUBLIC_CONTACT_EMAIL=gfuchs@fuchs-sales.ca
