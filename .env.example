# Copy to .env.local and fill in. Never commit real values.
# Contact form: iCloud SMTP (see README "Environment variables").
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@icloud.com
# Apple app-specific password (appleid.apple.com > Sign-In and Security)
SMTP_PASS=
SMTP_FROM="Fuchs Sales and Consulting <you@icloud.com>"
SMTP_TO=you@icloud.com

# Shown in mailto links on the site
NEXT_PUBLIC_CONTACT_EMAIL=gfuchs@fuchs-sales.ca
